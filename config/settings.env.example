# Copy to /DATA/AppData/neatbase/config/settings.env on the host.
# Values here override docker-compose.yml / .env. Restart the app after editing:
#   docker compose restart
#
# Your Coinbase key: put the JSON file you downloaded from portal.cdp.coinbase.com
# next to this file as cdp_api_key.json (it contains "name" and "privateKey").
# Alternatively set it here (the file wins if both exist):
# COINBASE_API_KEY=organizations/xxx/apiKeys/yyy
# COINBASE_API_SECRET="-----BEGIN EC PRIVATE KEY-----\nMHc...\n-----END EC PRIVATE KEY-----\n"

# With a key present, your real Coinbase fee tier is used for training and paper trading.

# ---- Going live (real money) ----
# TRADING_MODE=live
# LIVE_CONFIRM=I_UNDERSTAND_THIS_USES_REAL_MONEY
# LIVE_MAX_USD=50
# HALT_DRAWDOWN_PCT=25
