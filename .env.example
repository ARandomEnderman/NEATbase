# Copy to .env and edit. Everything has a sensible default; this file is optional.

# ---- Market ----
PRODUCT_ID=BTC-USD
# Candle size in seconds: 60, 300, 900, 1800, 3600, 7200, 21600, 86400
GRANULARITY=3600

# ---- Costs (used identically in training and paper trading) ----
# Coinbase Advanced Trade taker fee for your tier. 0.012 = 1.20% (lowest tier).
# If API keys are set below, your real fee tier is read from Coinbase instead.
TAKER_FEE=0.012
# Extra adverse price movement per fill, in basis points (1bp = 0.01%)
SLIPPAGE_BPS=5
# Training only: assumed bid/ask spread (live paper trading uses the real order book)
SPREAD_BPS=2

# ---- Strategy ----
POSITION_FRACTION=1.0
BUY_THRESHOLD=0.2
SELL_THRESHOLD=-0.2

# ---- Training ----
TRAIN_DAYS=60
VALIDATION_DAYS=14
GENERATIONS_PER_CYCLE=100
RETRAIN_INTERVAL_HOURS=3
POP_SIZE=150
NUM_WORKERS=2
# CPU cores the trainer container may use
TRAINER_CPUS=2
FITNESS_CHUNKS=4
DRAWDOWN_PENALTY=0.5
INACTIVITY_PENALTY=0.25

# ---- Trading ----
TRADING_MODE=paper
PAPER_START_USD=1000
WEB_PORT=8080
# Where data lives on the host (ZimaOS default shown)
DATA_PATH=/DATA/AppData/neatbase

# ---- Live trading (real money!) ----
# Create a CDP API key at https://portal.cdp.coinbase.com/ with "trade" + "view" permission.
# The secret is the EC private key; keep the \n line breaks on one line.
# COINBASE_API_KEY=organizations/xxx/apiKeys/yyy
# COINBASE_API_SECRET=-----BEGIN EC PRIVATE KEY-----\nMHc...\n-----END EC PRIVATE KEY-----\n
# TRADING_MODE=live
# LIVE_CONFIRM=I_UNDERSTAND_THIS_USES_REAL_MONEY
# LIVE_MAX_USD=50
# HALT_DRAWDOWN_PCT=25
